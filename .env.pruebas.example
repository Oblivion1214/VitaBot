# Esta plantilla es para una COPIA INDEPENDIENTE; no contiene credenciales del principal.
BOT_ENV=test
PRODUCTION_ENV_PATH=/home/usuario/VitaBot/.env
TOKEN=
CLIENT_ID=
TEST_GUILD_ID=
AUDIT_CONFIG_PATH=/home/usuario/.config/VitaBot-pruebas/audit-config.json
SECURITY_STATE_PATH=/home/usuario/.config/VitaBot-pruebas/security-state.json
# Audio reservado para pruebas en la PC; no reutilizar la clave ni el puerto del principal.
PC_AUDIO_URL=http://IP_TAILSCALE_PC:3003
AUDIO_SHARED_TOKEN=
# Habilitar proveedores sólo con claves propias de pruebas.
GEMINI_API_KEY=
GENIUS_TOKEN=
HF_TOKEN=
VIRUSTOTAL_KEY=
GOOGLE_SAFE_BROWSING_KEY=
IPQS_KEY=
URLSCAN_KEY=
URLHAUS_KEY=
URLSCAN_ENABLED=false
