TOKEN=tu_token_de_discord_aqui
CLIENT_ID=tu_client_id_aqui
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Opcional: hasta 8 IDs de modelos Gemini separados por comas, en orden de preferencia.
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview
# GEMINI_ANALYSIS_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview
# Gemini 2.5 solo sirve si el proyecto aún tiene acceso; compruébalo antes de añadirlo.
# HF_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell,stabilityai/stable-diffusion-xl-base-1.0
GENIUS_TOKEN=tu_token_de_genius_aqui
HF_TOKEN=tu_token_de_huggingface_aqui
VIRUSTOTAL_KEY=tu_api_key_de_virustotal_aqui
GOOGLE_SAFE_BROWSING_KEY=tu_api_key_de_google_safe_browsing_aqui
IPQS_KEY=tu_api_key_de_ipqs_aqui
URLSCAN_KEY=tu_api_key_de_urlscan_aqui
# Desactivado por defecto. Solo intenta informes privados, nunca públicos.
# Requiere que tu plan de urlscan permita visibility=private.
URLSCAN_ENABLED=false
URLHAUS_KEY=tu_api_key_de_urlhaus_aqui
# Audio en la VM: conexión privada a la PC.
PC_AUDIO_URL=http://nombre-de-tu-pc:3001
AUDIO_SHARED_TOKEN=misma_clave_de_al_menos_32_caracteres_que_en_la_pc
# Máximo de canales de voz activos. Docker usa 1 para este servidor.
MUSIC_MAX_SESSIONS=3
# Copias de despliegue de la MISMA identidad comparten archivo; pruebas independiente usa otro.
# AUDIT_CONFIG_PATH=/ruta/privada/audit-config.json
# Por defecto, security-state.json junto a AUDIT_CONFIG_PATH (compartido entre main/pruebas).
# SECURITY_STATE_PATH=/ruta/privada/security-state.json
# Las herramientas y cookies se configuran solo en .env.audio de la PC.
# Producción puede omitir BOT_ENV. La copia de pruebas debe usar otra aplicación y estado propio.
BOT_ENV=production
# BOT_ENV=test
# PRODUCTION_ENV_PATH=/ruta/al/bot/principal/.env
